{
  "id": "hf_spots_summary",
  "type": "hf_spots_summary",

  "interaction": {
    "browsable": true
  },

  "focusable": true,

  "refresh": {
    "mode": "push",
    "topic": "state.changed",
    "fallbackPollMs": 5000
  },

  "bindings": [
    { "id": "spots", "source": "state", "key": "rt:hf:spots:selected" },
    { "id": "context", "source": "state", "key": "rt:hf:context" },
    { "id": "ui_browse", "source": "state", "key": "rt:ui:browse:hf_spots_summary" }
  ],

  "actions": [],

  "meta": {
    "purpose": "Browse DX spots for the selected HF band.",
    "title": "HF Spots",
    "contract": {
      "requiredBindings": ["spots", "context"],
      "allowNull": ["ui_browse"]
    }
  }
}