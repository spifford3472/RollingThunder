{
  "id": "vhf_side_b_summary",
  "type": "vhf_side_b_summary",

  "interaction": {
    "browsable": false
  },

  "focusable": true,

  "refresh": {
    "mode": "push",
    "topic": "state.changed",
    "fallbackPollMs": 5000
  },

  "bindings": [
    { "id": "page", "source": "state", "key": "rt:vhf:page" },
    { "id": "scan", "source": "state", "key": "rt:vhf:scan" }
  ],

  "actions": [],

  "meta": {
    "purpose": "Passive VHF scan/status/action display bound to controller-owned rt:vhf:page. START/STOP emits only vhf.scan.set_enabled through the standard UI intent path.",
    "title": "VHF Status",
    "contract": {
      "requiredBindings": [],
      "allowNull": ["page", "scan"]
    }
  }
}