{
  "id": "hf",
  "order": 20,
  "title": "HF",

  "layout": {
    "top": ["topbar_core"],
    "middle": [
      ["hf_bands_summary","hf_spots_summary"],
      ["hf_map_summary", "hf_detail_summary"]
    ],
    "bottom": ["alerts_overlay"]
  },

  "requires": ["redis_state", "mqtt_bus"],
  "optional": ["logging", "node_health"],

  "controls": {
    "allowedIntents": [
      "ui.page.next",
      "ui.page.prev",
      "ui.focus.next",
      "ui.focus.prev",
      "ui.ok",
      "ui.cancel",
      "ui.back",
      "ui.browse.delta",
      "ui.encoder.press",
      "alert.ack",
      "alert.silence",
      "hf.select_band",
      "hf.select_spot",
      "hf.refresh_spots",
      "hf.spot.outcome",
      "radio.tune",
      "radio.log_qso"
    ]
  },

  "focusPolicy": {
    "defaultPanel": "hf_bands_summary",
    "rotation": [
      "hf_bands_summary",
      "hf_spots_summary",
      "alerts_overlay"
    ]
  },

  "meta": {
    "purpose": "Workable general HF DX spotting page using DXSpider and QRZ enrichment."
  }
}