[Unit]
Description=RollingThunder External Fan Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spiff
Group=spiff
SupplementaryGroups=gpio
WorkingDirectory=/tmp
Environment=HOME=/home/spiff
Environment=RT_NODE_ID=rt-radio
EnvironmentFile=/etc/rollingthunder/redis.env
ExecStart=/usr/bin/python3 /opt/rollingthunder/nodes/rt-radio/services/external_fan_monitor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target