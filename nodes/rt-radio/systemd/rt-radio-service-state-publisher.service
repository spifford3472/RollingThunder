[Unit]
Description=RollingThunder Service State Publisher (systemd -> Redis)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=spiff
Environment=RT_NODE_ID=rt-radio
Environment=RT_PRUNE_MISSING=1
Environment=RT_KEY_SERVICE_PREFIX=rt:services:
Environment=RT_REDIS_HOST=192.168.8.134
Environment=RT_REDIS_PORT=6379
Environment=RT_REDIS_DB=0
Environment=RT_REDIS_TIMEOUT_SEC=0.35
Environment=RT_POLL_SEC=15.0
EnvironmentFile=/etc/rollingthunder/redis.env
Environment=RT_UNIT_MAP_JSON={"rigctld":"rigctld.service","rigctld-watchdog":"rt-rigctld-watchdog.service","radio-presence":"rt-radio-presence.service","service-state-publisher":"rt-radio-service-state-publisher.service","ui-intent-worker":"rt-radio-ui-intent-worker.service","external-fan-monitor":"rt-external-fan-monitor.service"}
ExecStart=/usr/bin/python3 /opt/rollingthunder/nodes/rt-radio/services/rt-radio-service-state-publisher.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

