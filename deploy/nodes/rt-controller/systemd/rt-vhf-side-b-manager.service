[Unit]
Description=RollingThunder VHF Side B monitor state publisher
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rollingthunder
Environment=RT_REDIS_HOST=127.0.0.1
Environment=RT_REDIS_PORT=6379
Environment=RT_REDIS_DB=0
EnvironmentFile=/etc/rollingthunder/redis.env
ExecStart=/usr/bin/python3 /opt/rollingthunder/services/vhf_side_b_manager.py
Restart=always
RestartSec=5
User=spiff

# Phase 5 safety: this service only publishes desired Side B state.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target