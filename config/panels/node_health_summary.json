{
  "id": "node_health_summary",
  "type": "node_health_summary",
  "interaction": {
    "browsable": true
  },
  "focusable": true,

  "refresh": { "mode": "push", "topic": "state.changed", "fallbackPollMs": 5000 },

  "bindings": [
    {
      "id": "model",
      "source": "state",
      "key": "rt:ui:model:node_health_summary"
    }
  ],

  "actions": [
    { "intent": "host.status", "params": { "scope": "summary" } }
  ],

  "meta": {
    "purpose": "At-a-glance health of nodes/services.",
    "title": "Node Health Summary",
    "contract": {
      "requiredBindings": ["model"],
      "allowNull": []
    }
  }
}