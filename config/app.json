      "high_mhz": 54.0
    }
  },
  "potaBandDefaults": {
    "160m": 1.9,
    "80m": 3.9,
    "60m": 5.357,
    "40m": 7.2,
    "30m": 10.12,
    "20m": 14.285,
    "17m": 18.14,
    "15m": 21.285,
    "12m": 24.95,
    "10m": 28.4
  },
  "vhf": {
    "radio_control_mode": "dry_run",
    "radio_force_publish_sec": 300,
    "radio_monitor_enabled": true,
    "radio_monitor_interval_sec": 30,
    "radio_name": "Icom IC-2730A",
    "repeater_bucket_degrees": 0.25,
    "repeater_db_path": "/opt/rollingthunder/data/vhf/repeaters.sqlite3",
    "repeater_lookup_interval_sec": 30,
    "repeater_radius_miles": 25,
    "side_b": {
      "enabled": true,
      "default_frequency_mhz": 146.52,
      "default_mode": "FM",
      "label": "2m Calling",
      "receive_only": false,
      "publish_interval_seconds": 30
    },
    "scan": {
      "enabled_default": false,
      "reload_distance_miles": 20,
      "reload_radius_miles": 25,
      "movement_min_delta_miles": 0.05,
      "movement_jump_reject_miles": 5.0,
      "max_memory_channels_per_group": 100,
      "dry_run_reload_only": true,
      "publish_interval_seconds": 30,
      "force_publish_seconds": 300,
      "next_group": "C"
    },
    "ic2730a": {
      "enabled": true,
      "control_mode": "dry_run",
      "hamlib_model": 3072,
      "serial_port": "/dev/ic2730a",
      "baud": 9600,
      "timeout_seconds": 2.0,
      "writes_enabled": false,
      "scan_control_enabled": false,
      "side_b_programming_enabled": false,
      "memory_programming_enabled": false,
      "detect_enabled": true,
      "publish_adapter_status": true,
      "publish_interval_seconds": 30,
      "force_publish_seconds": 300,
      "direct_civ_enabled": true,
      "direct_civ_readonly_probe_enabled": true,
      "direct_civ_serial_port": "/dev/ic2730a",
      "direct_civ_baud": 9600,
      "direct_civ_controller_address_hex": "E0",
      "direct_civ_transceiver_address_hex": "90",
      "direct_civ_timeout_seconds": 2.0,
      "direct_civ_readonly_probe_commands": [
        "transceiver_id",
        "operating_frequency",
        "operating_mode",
        "duplex",
        "offset",
        "rx_tx_status"
      ],
      "direct_civ_tone_readonly_probe_enabled": false,
      "direct_civ_readonly_tone_probe_commands": [
        "tone_setting",
        "repeater_tone_frequency",
        "tone_squelch_frequency",
        "dtcs_code_polarity"
      ]
    },
    "request_poll_seconds": 1,
    "write_test": {
      "enabled": false,
      "allow_single_memory_write": false,
      "sacrificial_group": "D",
      "sacrificial_channel": 99,
      "frequency_mhz": 146.52,
      "mode": "FM",
      "name": "RT TEST",
      "tone_hz": null,
      "offset_mhz": 0.0,
      "duplex": "simplex"
    }
  }
}
