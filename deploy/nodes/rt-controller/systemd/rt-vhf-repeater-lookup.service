[Unit]
Description=RollingThunder VHF CSV-derived repeater cache lookup model
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rollingthunder
Environment=RT_REDIS_HOST=127.0.0.1
Environment=RT_REDIS_PORT=6379
Environment=RT_REDIS_DB=0
EnvironmentFile=/etc/rollingthunder/redis.env
ExecStart=/usr/bin/python3 /opt/rollingthunder/services/vhf_repeater_cache_lookup.py
Restart=always
RestartSec=5
User=spiff

# Phase 8.2 safety: this service only reads generated SQLite cache and writes Redis state.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
