{
  "schema": {
    "id": "rollingthunder.app",
    "version": "1.0.0",
    "compat": {
      "minReader": "1.0.0",
      "allowUnknownFields": true
    }
  },
  "runtimeVersion": {
    "major": 0,
    "minor": 55,
    "build": 36
  },
  "deploymentDefaults": {
    "fleet": "rollingthunder",
    "environment": "vehicle"
  },
  "globals": {
    "radio": {
      "has_tuner": false
    },
    "time": {
      "timezone": "America/New_York",
      "gpsIsAuthoritative": true
    },
    "state": {
      "redisUrl": "redis://127.0.0.1:6379",
      "namespace": "rt"
    },
    "bus": {
      "mqttUrl": "mqtt://127.0.0.1:1883",
      "topicRoot": "rt"
    },
    "api": {
      "controllerBaseUrl": "http://rt-controller.local:8787",
      "uiPollMs": 500
    },
    "defaults": {
      "serviceStartTimeoutMs": 4000,
      "serviceStopTimeoutMs": 3000,
      "healthPollMs": 2000
    },
    "safety": {
      "drivingMode": {
        "source": "gps_speed",
        "thresholdMph": 5
      },
      "noTextEntryWhenDriving": true
    },
    "dxSpider": {
      "pollIntervalSec": 600,
      "spotsPerNode": 40,
      "connectTimeoutSec": 10,
      "readTimeoutSec": 15,
      "logonName": "KI5VNB",
      "ssbBandSegmentsHz": {
        "40m": [
          {
            "low": 7125000,
            "high": 7300000,
            "mode": "LSB"
          }
        ],
        "20m": [
          {
            "low": 14150000,
            "high": 14350000,
            "mode": "USB"
          }
        ],
        "17m": [
          {
            "low": 18110000,
            "high": 18168000,
            "mode": "USB"
          }
        ],
        "15m": [
          {
            "low": 21200000,
            "high": 21450000,
            "mode": "USB"
          }
        ],
        "12m": [
          {
            "low": 24930000,
            "high": 24990000,
            "mode": "USB"
          }
        ],
        "10m": [
          {
            "low": 28300000,
            "high": 29700000,
            "mode": "USB"
          }
        ]
      },
      "nodes": [
        {
          "id": "local",
          "name": "Local DX Spider",
          "location": "Westfield, IN (EN82)",
          "telnetAddress": "dxc.w9na.net",
          "telnetPort": 7373,
          "logonName": "KI5VNB",
          "setNameCommand": "set/name Geoffrey",
          "setLocationCommand": "set/qra EM79"
        },
        {
          "id": "us_east",
          "name": "US East DX Spider",
          "location": "N. Chelmsford, MA (FN42)",
          "telnetAddress": "dxc.ad1c.us",
          "telnetPort": 7300,
          "logonName": "KI5VNB",
          "setNameCommand": "set/name Geoffrey",
          "setLocationCommand": "set/qra EM79"
        },
        {
          "id": "us_west",
          "name": "US West DX Spider",
          "location": "Bee Cave, TX (EM12)",
          "telnetAddress": "dxc-us.ab5k.net",
          "telnetPort": 7300,
          "logonName": "KI5VNB",
          "setNameCommand": "set/name Geoffrey",
          "setLocationCommand": "set/qra EM79"
        },
        {
          "id": "europe",
          "name": "Europe DX Spider",
          "location": "UK (IO91)",
          "telnetAddress": "dxspider.co.uk",
          "telnetPort": 7300,
          "logonName": "KI5VNB",
          "setNameCommand": "set/name Geoffrey",
          "setLocationCommand": "set/qra EM79"
        }
      ]
    }
  },
  "virtualPanel": {
    "enabled": true,
    "bind": "0.0.0.0",
    "port": 8630,
    "pollMs": 1000
  },
  "services": {
    "redis_state": {
      "id": "redis_state",
      "scope": "always_on",
      "ownerNode": "rt-controller",
      "lifecycle": {
        "startPolicy": "onBoot",
        "stopPolicy": "never",
        "restartPolicy": {
          "mode": "onFailure",
          "backoffMs": 2000,
          "maxBackoffMs": 30000
        }
      },
      "health": {
        "type": "redis_ping",
        "target": "globals.state.redisUrl",
        "staleAfterMs": 5000
      },
      "provides": [
        "state.core"
      ]
    },
    "mqtt_bus": {
      "id": "mqtt_bus",
      "scope": "always_on",
      "ownerNode": "rt-controller",
      "dependsOn": [
        "redis_state"
      ],
      "lifecycle": {
        "startPolicy": "onBoot",
        "stopPolicy": "never",
        "restartPolicy": {
          "mode": "onFailure",
          "backoffMs": 2000,
          "maxBackoffMs": 30000
        }
      },
      "health": {
        "type": "mqtt_ping",
        "target": "globals.bus.mqttUrl",
        "staleAfterMs": 10000
      },
      "provides": [
        "bus.core"
      ]
    },
    "gps_ingest": {
      "id": "gps_ingest",
      "scope": "always_on",
      "ownerNode": "rt-controller",
      "systemd": {
        "unit": "rt-gps-ingest.service"
      },
      "dependsOn": [
        "redis_state",
        "mqtt_bus"
      ],
      "lifecycle": {
        "startPolicy": "onBoot",
        "stopPolicy": "never",
        "restartPolicy": {
          "mode": "onFailure",
          "backoffMs": 2000,
          "maxBackoffMs": 30000
        }
      },
      "health": {
        "type": "state_freshness",
        "target": {
          "key": "rt:gps:fix",
          "namespace": "globals.state.namespace"
        },
        "staleAfterMs": 3000
      },
      "provides": [
        "state.gps.fix",
        "state.gps.time",
        "state.gps.speed"
      ],
      "consumes": []
    },
    "pota_nearby_parks": {
      "id": "pota_nearby_parks",
      "scope": "always_on",
      "ownerNode": "rt-controller",
      "systemd": {
        "unit": "rt-pota-nearby-parks.service"
      },
      "dependsOn": [
        "redis_state",
        "gps_ingest"
      ],
      "lifecycle": {
        "startPolicy": "onBoot",
        "stopPolicy": "never",
        "restartPolicy": {
          "mode": "onFailure",
          "backoffMs": 2000,
          "maxBackoffMs": 30000
        }
      },
      "health": {
        "type": "state_freshness",
        "target": {
          "key": "rt:pota:nearby",
          "namespace": "globals.state.namespace"
        },
        "staleAfterMs": 5000
      },
      "provides": [
        "state.pota.nearby",
        "alerts.pota.nearby"
      ]
    },
    "pota_context_manager": {
      "id": "pota_context_manager",
      "scope": "always_on",
      "ownerNode": "rt-controller",
      "systemd": {
        "unit": "rt-pota-context-manager.service"
      },
      "dependsOn": [
        "redis_state",
        "pota_nearby_parks"
      ],
      "lifecycle": {
        "startPolicy": "onBoot",
        "stopPolicy": "never",
        "restartPolicy": {
          "mode": "onFailure",
          "backoffMs": 2000,
          "maxBackoffMs": 30000
        }
      },
      "health": {
        "type": "state_freshness",
        "target": {
          "key": "rt:pota:ui:ssb:bands",
          "namespace": "globals.state.namespace"
        },
        "staleAfterMs": 5000
      },
      "provides": [
        "state.pota.context",
        "state.pota.ui.ssb.bands",
        "state.pota.ui.ssb.spots"
      ]
    },
    "logging": {
      "id": "logging",
      "scope": "always_on",
      "ownerNode": "rt-controller",
      "dependsOn": [
        "redis_state"
      ],
      "lifecycle": {
        "startPolicy": "onBoot",
        "stopPolicy": "never",
        "restartPolicy": {
          "mode": "onFailure",
          "backoffMs": 2000,
          "maxBackoffMs": 30000
        }
      },
      "health": {
        "type": "state_freshness",
        "target": {
          "key": "rt:logging:alive",
          "namespace": "globals.state.namespace"
        },
        "staleAfterMs": 10000
      },
      "provides": [
        "state.logging",
        "logs.events"
      ]
    },
    "node_health": {
      "id": "node_health",
      "scope": "always_on",
      "ownerNode": "rt-controller",
      "dependsOn": [
        "redis_state",
        "mqtt_bus"
      ],
      "lifecycle": {
        "startPolicy": "onBoot",
        "stopPolicy": "never",
        "restartPolicy": {
          "mode": "onFailure",
          "backoffMs": 2000,
          "maxBackoffMs": 30000
        }
      },
      "health": {
        "type": "http_json",
        "target": "http://rt-controller.local:8787/health",
        "okRules": [
          {
            "path": "$.ok",
            "equals": true
          }
        ],
        "staleAfterMs": 5000
      },
      "provides": [
        "state.nodes.health"
      ]
    },
    "noaa_same": {
      "id": "noaa_same",
      "scope": "always_on",
      "ownerNode": "rt-controller",
      "dependsOn": [
        "redis_state",
        "mqtt_bus",
        "gps_ingest"
      ],
      "lifecycle": {
        "startPolicy": "onBoot",
        "stopPolicy": "never",
        "restartPolicy": {
          "mode": "onFailure",
          "backoffMs": 5000,
          "maxBackoffMs": 60000
        }
      },
      "health": {
        "type": "state_freshness",
        "target": {
          "key": "rt:noaa:decoder",
          "namespace": "globals.state.namespace"
        },
        "staleAfterMs": 15000
      },
      "provides": [
        "alerts.noaa",
        "state.noaa.station",
        "state.noaa.county"
      ]
    },
    "meshtastic_c2": {
      "id": "meshtastic_c2",
      "scope": "always_on",
      "ownerNode": "rt-controller",
      "dependsOn": [
        "redis_state",
        "mqtt_bus"
      ],
      "lifecycle": {
        "startPolicy": "onBoot",
        "stopPolicy": "never",
        "restartPolicy": {
          "mode": "onFailure",
          "backoffMs": 5000,
          "maxBackoffMs": 60000
        }
      },
      "health": {
        "type": "state_freshness",
        "target": {
          "key": "rt:meshtastic:link",
          "namespace": "globals.state.namespace"
        },
        "staleAfterMs": 30000
      },
      "permissions": {
        "default": "read_only",
        "allowListedSenders": [],
        "writeCapabilities": {
          "serviceControl": {
            "enabled": false,
            "allowServices": []
          },
          "pageChange": {
            "enabled": false,
            "allowPages": []
          }
        }
      },
      "rateLimits": {
        "statusPerMinute": 12,
        "alertsPerMinute": 6,
        "maxMessageBytes": 180
      },
      "provides": [
        "bus.meshtastic.status",
        "alerts.meshtastic"
      ]
    },
    "hf_radio_proxy": {
      "id": "hf_radio_proxy",
      "scope": "page_scoped",
      "ownerNode": "rt-radio",
      "dependsOn": [],
      "lifecycle": {
        "startPolicy": "onPageEnter",
        "stopPolicy": "onLastUserExit",
        "restartPolicy": {
          "mode": "never"
        }
      },
      "health": {
        "type": "http_json",
        "target": "http://rt-radio.local:8801/health",
        "okRules": [
          {
            "path": "$.ok",
            "equals": true
          }
        ],
        "staleAfterMs": 5000
      },
      "provides": [
        "state.hf.snapshot"
      ]
    },
    "alerts_reconciler": {
      "id": "alerts_reconciler",
      "scope": "always_on",
      "ownerNode": "rt-controller",
      "systemd": {
        "unit": "rt-alerts-reconciler.service"
      },
      "lifecycle": {
        "startPolicy": "onBoot",
        "stopPolicy": "never",
        "restartPolicy": {
          "mode": "onFailure",
          "backoffMs": 2000,
          "maxBackoffMs": 30000
        }
      },
      "health": {
        "type": "http_json",
        "target": "http://rt-controller.local:8787/alerts_health",
        "okRules": [
          {
            "path": "$.ok",
            "equals": true
          }
        ],
        "staleAfterMs": 5000
      },
      "provides": [
        "state.nodes.alerts_reconciler"
      ]
    },
    "service_state_publisher": {
      "id": "service_state_publisher",
      "scope": "always_on",
      "ownerNode": "rt-controller",
      "systemd": {
        "unit": "rt-service-state-publisher.service"
      },
      "lifecycle": {
        "startPolicy": "onBoot",
        "stopPolicy": "never",
        "restartPolicy": {
          "mode": "onFailure",
          "backoffMs": 2000,
          "maxBackoffMs": 30000
        }
      },
      "health": {
        "type": "http_json",
        "target": "http://rt-controller.local:8787/alerts_health",
        "okRules": [
          {
            "path": "$.ok",
            "equals": true
          }
        ],
        "staleAfterMs": 5000
      },
      "provides": [
        "state.nodes.service_state_publisher"
      ]
    }
  },
  "pages": {
    "include": [
      "pages.manifest.json"
    ]
  },
  "panels": {
    "include": [
      "panels.manifest.json"
    ]
  },
  "inputs": {
    "sources": {},
    "maps": []
  },
  "alerts": {
    "normalization": {},
    "dedup": {
      "rules": []
    },
    "routing": [],
    "acknowledgement": {},
    "rateLimits": {}
  },
  "meta": {
    "notes": "Skeleton only. Populate services/pages/panels next."
  },
  "bandOrder": [
    "160m",
    "80m",
    "60m",
    "40m",
    "30m",
    "20m",
    "17m",
    "15m",
    "12m",
    "10m",
    "6m"
  ],
  "bands": {
    "160m": {
      "low_mhz": 1.8,
      "high_mhz": 2.0
    },
    "80m": {
      "low_mhz": 3.5,
      "high_mhz": 4.0
    },
    "60m": {
      "low_mhz": 5.0,
      "high_mhz": 5.5
    },
    "40m": {
      "low_mhz": 7.0,
      "high_mhz": 7.3
    },
    "30m": {
      "low_mhz": 10.1,
      "high_mhz": 10.15
    },
    "20m": {
      "low_mhz": 14.0,
      "high_mhz": 14.35
    },
    "17m": {
      "low_mhz": 18.068,
      "high_mhz": 18.168
    },
